# .env.example - Rename to .env and fill in your values

PORT=5000

# Get from MongoDB Atlas or your local setup
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster-url>/<databaseName>?retryWrites=true&w=majority

# Use a strong, unique secret (e.g., openssl rand -base64 32)
JWT_SECRET=your_very_strong_and_secret_jwt_key
JWT_EXPIRE=30d # e.g., 1h, 7d, 30d

# SMTP Credentials (e.g., Mailtrap, SendGrid, Gmail App Password)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_user_or_apikey_name
EMAIL_PASS=your_email_password_or_apikey
# EMAIL_FROM_ADDRESS=noreply@yourapp.com # Optional: Defaults to EMAIL_USER
# EMAIL_FROM_NAME="Your App Name" # Optional: Defaults to AuthStarter App

# Base URL of your frontend application
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration (set to false to disable)
ENABLE_GOOGLE_LOGIN=true
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# GitHub OAuth Configuration (Optional - Coming Soon?)
# ENABLE_GITHUB_LOGIN=false
# GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
# GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>